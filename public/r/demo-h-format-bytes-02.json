{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "demo-h-format-bytes-02",
  "title": "formatBytes (Storage Meter)",
  "description": "Storage meter with dynamic byte conversion",
  "dependencies": [
    "@tabler/icons-react"
  ],
  "registryDependencies": [
    "https://www.spaceui.one/r/hooks-utils-format-bytes.json"
  ],
  "files": [
    {
      "path": "src/registry/demo/hooks/utils/format-bytes/h-format-bytes-02/index.tsx",
      "content": "'use client'\n\nimport * as React from 'react'\nimport { formatBytes } from '@/utils/format-bytes'\nimport { Card, CardPanel } from '@/components/ui/card'\nimport { Badge } from '@/components/ui/badge'\nimport { IconDatabase } from '@tabler/icons-react'\n\nexport default function Demo() {\n  const usedBytes = 48318382080\n  const totalBytes = 107374182400\n  const percentage = Math.round((usedBytes / totalBytes) * 100)\n\n  return (\n    <Card className=\"w-full max-w-md bg-muted rounded-2xl overflow-hidden\">\n      <div className=\"flex items-center justify-between gap-3 px-3 pt-1 pb-1\">\n        <div className=\"flex items-center gap-2 text-sm font-semibold text-foreground\">\n          <Badge variant=\"secondary\" className=\"rounded-sm aspect-square h-full! bg-transparent\">\n            <IconDatabase className=\"size-4 text-muted-foreground\" />\n          </Badge>\n          <span>Storage</span>\n        </div>\n        <Badge variant=\"outline\" size=\"sm\" className=\"font-mono tabular-nums\">\n          {percentage}%\n        </Badge>\n      </div>\n      <CardPanel className=\"flex flex-col gap-3 rounded-[0.875rem] bg-background p-3\">\n        <div className=\"h-2 overflow-hidden rounded-full bg-muted\">\n          <div style={{ width: `${percentage}%` }} className=\"h-full bg-primary\" />\n        </div>\n        <div className=\"grid grid-cols-2 gap-2\">\n          <div className=\"rounded-lg bg-muted p-2.5\">\n            <span className=\"block text-[.6875rem] font-semibold text-muted-foreground\">Used</span>\n            <span className=\"mt-0.5 block font-mono text-sm font-semibold tabular-nums text-foreground\">\n              {formatBytes(usedBytes, { decimals: 1 })}\n            </span>\n          </div>\n          <div className=\"rounded-lg bg-muted p-2.5\">\n            <span className=\"block text-[.6875rem] font-semibold text-muted-foreground\">Total</span>\n            <span className=\"mt-0.5 block font-mono text-sm font-semibold tabular-nums text-foreground\">\n              {formatBytes(totalBytes, { decimals: 0 })}\n            </span>\n          </div>\n        </div>\n      </CardPanel>\n    </Card>\n  )\n}\n",
      "type": "registry:hook",
      "target": "components/spaceui/format-bytes.tsx"
    }
  ],
  "categories": [
    "hooks",
    "utils",
    "format-bytes"
  ],
  "type": "registry:hook"
}