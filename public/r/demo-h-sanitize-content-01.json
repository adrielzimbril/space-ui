{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "demo-h-sanitize-content-01",
  "title": "useSanitizeContent",
  "description": "SSR-safe HTML XSS Sanitizer",
  "dependencies": [
    "@tabler/icons-react"
  ],
  "registryDependencies": [
    "https://www.spaceui.one/r/hooks-form-use-sanitize-content.json",
    "https://www.spaceui.one/r/primitives-badge.json",
    "https://www.spaceui.one/r/primitives-card.json",
    "https://www.spaceui.one/r/primitives-textarea.json"
  ],
  "files": [
    {
      "path": "src/registry/demo/hooks/form/sanitize-content/h-sanitize-content-01/index.tsx",
      "content": "'use client'\n\nimport * as React from 'react'\nimport { useSanitizeContent } from '@/hooks/use-sanitize-content'\nimport { Card, CardPanel } from '@/components/ui/card'\nimport { Badge } from '@/components/ui/badge'\nimport { Textarea } from '@/components/ui/textarea'\nimport { IconShieldCheck } from '@tabler/icons-react'\n\nexport default function Demo() {\n  const [raw, setRaw] = React.useState('<p>Hello <strong>World</strong>!</p><script>alert(\"XSS\")</script>')\n  const clean = useSanitizeContent(raw)\n\n  return (\n    <Card className=\"w-full max-w-md bg-muted rounded-2xl overflow-hidden\">\n      <div className=\"flex items-center justify-between gap-3 px-3 pt-1 pb-1\">\n        <div className=\"flex items-center gap-2 text-sm font-semibold text-foreground\">\n          <Badge variant=\"secondary\" className=\"rounded-sm aspect-square h-full! bg-transparent\">\n            <IconShieldCheck className=\"size-4 text-muted-foreground\" />\n          </Badge>\n          <span>Sanitize</span>\n        </div>\n        <Badge variant=\"success\" size=\"sm\">\n          Protected\n        </Badge>\n      </div>\n      <CardPanel className=\"flex flex-col gap-3 rounded-[0.875rem] bg-background p-3\">\n        <Textarea\n          value={raw}\n          onChange={(e) => setRaw(e.target.value)}\n          rows={2}\n          className=\"font-mono text-base sm:text-sm resize-none\"\n          aria-label=\"Raw HTML\"\n        />\n        <div className=\"rounded-lg bg-muted p-2.5\">\n          <span className=\"block text-[.6875rem] font-semibold text-muted-foreground\">Output</span>\n          <span className=\"mt-0.5 block break-all font-mono text-sm font-semibold text-foreground\">{clean}</span>\n        </div>\n      </CardPanel>\n    </Card>\n  )\n}\n",
      "type": "registry:hook",
      "target": "components/spaceui/sanitize-content.tsx"
    }
  ],
  "categories": [
    "hooks",
    "form",
    "sanitize-content"
  ],
  "type": "registry:hook"
}