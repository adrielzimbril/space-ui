      "path": "src/registry/demo/hooks/dom/mouse-position/h-mouse-position-01/index.tsx",
      "content": "'use client'\n\nimport * as React from 'react'\nimport { useMousePosition } from '@/hooks/use-mouse-position'\nimport { Card, CardPanel } from '@/components/ui/card'\nimport { Badge } from '@/components/ui/badge'\nimport { IconCrosshair } from '@tabler/icons-react'\n\nexport default function Demo() {\n  const { x, y } = useMousePosition()\n\n  return (\n    <Card className=\"w-full max-w-md bg-muted rounded-2xl overflow-hidden\">\n      <div className=\"flex items-center justify-between gap-3 px-3 pt-1 pb-1\">\n        <div className=\"flex items-center gap-2 text-sm font-semibold text-foreground\">\n          <Badge variant=\"secondary\" className=\"rounded-sm aspect-square h-full! bg-transparent\">\n            <IconCrosshair className=\"size-4 text-muted-foreground\" />\n          </Badge>\n          <span>Pointer</span>\n        </div>\n        <Badge variant=\"outline\" size=\"sm\">\n          Live\n        </Badge>\n      </div>\n      <CardPanel className=\"grid grid-cols-2 gap-2 rounded-[0.875rem] bg-background p-3\">\n        <div className=\"rounded-lg bg-muted p-2.5\">\n          <span className=\"block text-[.6875rem] font-semibold text-muted-foreground\">X</span>\n          <span className=\"mt-0.5 block font-mono text-xl font-semibold tabular-nums text-foreground\">\n            {Math.round(x)}\n          </span>\n        </div>\n        <div className=\"rounded-lg bg-muted p-2.5\">\n          <span className=\"block text-[.6875rem] font-semibold text-muted-foreground\">Y</span>\n          <span className=\"mt-0.5 block font-mono text-xl font-semibold tabular-nums text-foreground\">\n            {Math.round(y)}\n          </span>\n        </div>\n      </CardPanel>\n    </Card>\n  )\n}\n",
      "type": "registry:hook",
      "target": "components/spaceui/mouse-position.tsx"
    }
  ],
  "categories": [
    "hooks",
    "dom",
    "mouse-position"
  ],
  "type": "registry:hook"
}