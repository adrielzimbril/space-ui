{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "demo-p-slider-11",
  "title": "Slider 11",
  "description": "Slider with icons",
  "dependencies": [
    "@tabler/icons-react",
    "lucide-react"
  ],
  "registryDependencies": [
    "@usespaceui/primitives-field",
    "@usespaceui/primitives-slider"
  ],
  "files": [
    {
      "path": "src/registry/demo/primitives/slider/p-slider-11/index.tsx",
      "content": "'use client'\n\nimport { IconVolume, IconVolumeOff } from '@tabler/icons-react'\nimport { useState } from 'react'\nimport { Field, FieldLabel } from '@/components/ui/field'\nimport { Slider, SliderValue } from '@/components/ui/slider'\n\nexport default function Particle() {\n  const [value, setValue] = useState<number | readonly number[]>(25)\n\n  return (\n    <Field className=\"*:grid *:grid-cols-[auto_1fr_auto] *:items-center *:gap-x-2\">\n      <Slider aria-label=\"Volume slider\" onValueChange={setValue} value={value}>\n        <div className=\"col-span-3 mb-2 flex items-center justify-between gap-1\">\n          <FieldLabel>Volume</FieldLabel>\n          <SliderValue />\n        </div>\n        <IconVolumeOff aria-hidden=\"true\" className=\"size-4 shrink-0 opacity-80\" />\n        <IconVolume aria-hidden=\"true\" className=\"order-1 size-4 shrink-0 opacity-80\" />\n      </Slider>\n    </Field>\n  )\n}\n",
      "type": "registry:ui",
      "target": "components/spaceui/slider.tsx"
    }
  ],
  "categories": [
    "slider"
  ],
  "type": "registry:ui"
}