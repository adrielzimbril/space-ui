      "path": "src/registry/demo/primitives/progress/p-progress-03/index.tsx",
      "content": "'use client'\n\nimport {\n  Progress,\n  ProgressIndicator,\n  ProgressLabel,\n  ProgressTrack,\n  ProgressValue,\n} from '@/components/ui/progress'\n\nexport default function Demo() {\n  return (\n    <Progress max={512} value={502}>\n      <div className=\"flex items-center justify-between gap-2\">\n        <ProgressLabel>Upload</ProgressLabel>\n        <ProgressValue>{(_formatted, value) => `${value} / 512`}</ProgressValue>\n      </div>\n      <ProgressTrack>\n        <ProgressIndicator />\n      </ProgressTrack>\n    </Progress>\n  )\n}\n",
      "type": "registry:ui",
      "target": "components/spaceui/progress.tsx"
    }
  ],
  "categories": [
    "progress"
  ],
  "type": "registry:ui"
