      "path": "src/registry/demo/primitives/combobox/p-combobox-2/index.tsx",
      "content": "import { Combobox, ComboboxInput, ComboboxItem, ComboboxList, ComboboxPopup } from '@/components/ui/combobox'\n\nconst items = ['Apple', 'Banana', 'Blueberry', 'Grapes', 'Pineapple']\n\nexport default function Particle() {\n  return (\n    <div className=\"flex w-full max-w-sm flex-col gap-3\">\n      <Combobox items={items}>\n        <ComboboxInput placeholder=\"Combobox (sm)\" size=\"sm\" />\n        <ComboboxPopup>\n          <ComboboxList>\n            {items.map((item) => (\n              <ComboboxItem key={item} value={item}>\n                {item}\n              </ComboboxItem>\n            ))}\n          </ComboboxList>\n        </ComboboxPopup>\n      </Combobox>\n\n      <Combobox items={items}>\n        <ComboboxInput placeholder=\"Combobox (default)\" size=\"default\" />\n        <ComboboxPopup>\n          <ComboboxList>\n            {items.map((item) => (\n              <ComboboxItem key={item} value={item}>\n                {item}\n              </ComboboxItem>\n            ))}\n          </ComboboxList>\n        </ComboboxPopup>\n      </Combobox>\n\n      <Combobox items={items}>\n        <ComboboxInput placeholder=\"Combobox (lg)\" size=\"lg\" />\n        <ComboboxPopup>\n          <ComboboxList>\n            {items.map((item) => (\n              <ComboboxItem key={item} value={item}>\n                {item}\n              </ComboboxItem>\n            ))}\n          </ComboboxList>\n        </ComboboxPopup>\n      </Combobox>\n    </div>\n  )\n}\n",
      "type": "registry:ui",
      "target": "components/spaceui/p-combobox-2.tsx"
    }
  ],
  "categories": [
    "combobox"
  ],
  "type": "registry:ui"
