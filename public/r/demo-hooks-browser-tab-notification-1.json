{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "demo-hooks-browser-tab-notification-1",
  "title": "useTabNotification",
  "description": "Document title badge notification",
  "dependencies": [
    "@tabler/icons-react"
  ],
  "registryDependencies": [
    "@usespaceui/hooks-browser-use-tab-notification",
    "@usespaceui/primitives-badge",
    "@usespaceui/primitives-button",
    "@usespaceui/primitives-card"
  ],
  "files": [
    {
      "path": "src/registry/demo/hooks/browser/tab-notification/h-tab-notification-1/index.tsx",
      "content": "'use client'\n\nimport * as React from 'react'\nimport { useTabNotification } from '@/hooks/use-tab-notification'\nimport { Card, CardPanel } from '@/components/ui/card'\nimport { Button } from '@/components/ui/button'\nimport { Badge } from '@/components/ui/badge'\nimport { IconBell, IconPlus, IconRotateClockwise } from '@tabler/icons-react'\n\nexport default function Demo() {\n  const [badge, setBadge] = React.useState(0)\n  useTabNotification(badge > 0 ? `(${badge}) Space UI` : 'Space UI')\n\n  return (\n    <Card className=\"w-full max-w-md bg-muted rounded-2xl overflow-hidden\">\n      <div className=\"flex items-center justify-between gap-3 px-3 pt-1 pb-1\">\n        <div className=\"flex items-center gap-2 text-sm font-semibold text-foreground\">\n          <Badge variant=\"secondary\" className=\"rounded-sm aspect-square h-full! bg-transparent\">\n            <IconBell className=\"size-4 text-muted-foreground\" />\n          </Badge>\n          <span>Tab</span>\n        </div>\n        <Badge variant={badge > 0 ? 'success' : 'outline'} size=\"sm\" className=\"font-mono tabular-nums\">\n          {badge}\n        </Badge>\n      </div>\n      <CardPanel className=\"flex items-center gap-2 rounded-[0.875rem] bg-background p-3\">\n        <Button size=\"sm\" onClick={() => setBadge((b) => b + 1)} className=\"flex-1\">\n          <IconPlus className=\"size-3.5\" />\n          Notify\n        </Button>\n        <Button\n          size=\"sm\"\n          variant=\"outline\"\n          onClick={() => setBadge(0)}\n          aria-label=\"Reset\"\n          className=\"shrink-0 text-muted-foreground hover:text-foreground\"\n        >\n          <IconRotateClockwise className=\"size-4\" />\n        </Button>\n      </CardPanel>\n    </Card>\n  )\n}\n",
      "type": "registry:hook",
      "target": "components/spaceui/h-tab-notification-1.tsx"
    }
  ],
  "categories": [
    "hooks",
    "browser",
    "tab-notification"
  ],
  "type": "registry:hook"
}