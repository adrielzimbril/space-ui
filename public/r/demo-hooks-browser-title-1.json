  "title": "useTitle",
  "description": "Document head title modifier",
  "dependencies": [
    "@tabler/icons-react"
  ],
  "registryDependencies": [
    "@usespaceui/hooks-browser-use-title",
    "@usespaceui/primitives-badge",
