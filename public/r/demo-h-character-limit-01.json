{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "demo-h-character-limit-01",
  "title": "useCharacterLimit",
  "description": "Character limit counter and progress",
  "dependencies": [
    "@tabler/icons-react"
  ],
  "registryDependencies": [
    "https://www.spaceui.one/r/hooks-form-use-character-limit.json",
    "https://www.spaceui.one/r/primitives-badge.json",
    "https://www.spaceui.one/r/primitives-card.json",
    "https://www.spaceui.one/r/primitives-progress.json",
    "https://www.spaceui.one/r/primitives-textarea.json"
  ],
  "files": [
    {
      "path": "src/registry/demo/hooks/form/character-limit/h-character-limit-01/index.tsx",
      "content": "'use client'\n\nimport * as React from 'react'\nimport { useCharacterLimit } from '@/hooks/use-character-limit'\nimport { Card, CardPanel } from '@/components/ui/card'\nimport { Badge } from '@/components/ui/badge'\nimport { Textarea } from '@/components/ui/textarea'\nimport { Progress } from '@/components/ui/progress'\nimport { IconAbc } from '@tabler/icons-react'\n\ninterface DemoProps {\n  maxLength?: number\n}\n\nexport default function Demo({ maxLength = 80 }: DemoProps) {\n  const { value, remaining, isExceeded, handleChange } = useCharacterLimit({\n    maxLength,\n    initialValue: 'Space UI provides production-ready React hooks.',\n  })\n  const percentage = Math.min(100, Math.round((value.length / maxLength) * 100))\n\n  return (\n    <Card className=\"w-full max-w-md bg-muted rounded-2xl overflow-hidden\">\n      <div className=\"flex items-center justify-between gap-3 px-3 pt-1 pb-1\">\n        <div className=\"flex items-center gap-2 text-sm font-semibold text-foreground\">\n          <Badge variant=\"secondary\" className=\"rounded-sm aspect-square h-full! bg-transparent\">\n            <IconAbc className=\"size-4 text-muted-foreground\" />\n          </Badge>\n          <span>Limit</span>\n        </div>\n        <Badge variant={isExceeded ? 'destructive' : 'outline'} size=\"sm\" className=\"font-mono tabular-nums\">\n          {remaining}\n        </Badge>\n      </div>\n      <CardPanel className=\"flex flex-col gap-3 rounded-[0.875rem] bg-background p-3\">\n        <Textarea\n          value={value}\n          onChange={handleChange}\n          rows={3}\n          className=\"text-base sm:text-sm resize-none\"\n          placeholder=\"Type something...\"\n          aria-label=\"Limited text\"\n        />\n        <div className=\"flex flex-col gap-1.5\">\n          <div className=\"flex justify-between text-[.6875rem] font-semibold text-muted-foreground\">\n            <span>Capacity</span>\n            <span className=\"font-mono tabular-nums\">{percentage}%</span>\n          </div>\n          <Progress value={percentage} />\n        </div>\n      </CardPanel>\n    </Card>\n  )\n}\n",
      "type": "registry:hook",
      "target": "components/spaceui/character-limit.tsx"
    }
  ],
  "categories": [
    "hooks",
    "form",
    "character-limit"
  ],
  "type": "registry:hook"
}