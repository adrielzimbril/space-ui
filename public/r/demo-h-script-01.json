{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "demo-h-script-01",
  "title": "useScript",
  "description": "Dynamic external script loader",
  "dependencies": [
    "@tabler/icons-react"
  ],
  "registryDependencies": [
    "https://www.spaceui.one/r/hooks-browser-use-script.json",
    "https://www.spaceui.one/r/primitives-badge.json",
    "https://www.spaceui.one/r/primitives-card.json"
  ],
  "files": [
    {
      "path": "src/registry/demo/hooks/browser/script/h-script-01/index.tsx",
      "content": "'use client'\n\nimport * as React from 'react'\nimport { useScript } from '@/hooks/use-script'\nimport { Card, CardPanel } from '@/components/ui/card'\nimport { Badge } from '@/components/ui/badge'\nimport { IconFileCode } from '@tabler/icons-react'\n\nexport default function Demo() {\n  const status = useScript('https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js')\n\n  return (\n    <Card className=\"w-full max-w-md bg-muted rounded-2xl overflow-hidden\">\n      <div className=\"flex items-center justify-between gap-3 px-3 pt-1 pb-1\">\n        <div className=\"flex items-center gap-2 text-sm font-semibold text-foreground\">\n          <Badge variant=\"secondary\" className=\"rounded-sm aspect-square h-full! bg-transparent\">\n            <IconFileCode className=\"size-4 text-muted-foreground\" />\n          </Badge>\n          <span>Script</span>\n        </div>\n        <Badge variant={status === 'ready' ? 'success' : 'outline'} size=\"sm\" className=\"capitalize\">\n          {status}\n        </Badge>\n      </div>\n      <CardPanel className=\"flex flex-col gap-3 rounded-[0.875rem] bg-background p-3\">\n        <div className=\"rounded-lg bg-muted p-2.5\">\n          <span className=\"block text-[.6875rem] font-semibold text-muted-foreground\">Source</span>\n          <span className=\"mt-0.5 block truncate font-mono text-sm font-semibold text-foreground\">canvas-confetti</span>\n        </div>\n      </CardPanel>\n    </Card>\n  )\n}\n",
      "type": "registry:hook",
      "target": "components/spaceui/script.tsx"
    }
  ],
  "categories": [
    "hooks",
    "browser",
    "script"
  ],
  "type": "registry:hook"
}