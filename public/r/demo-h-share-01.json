{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "demo-h-share-01",
  "title": "useShare",
  "description": "Native Web Share API caller",
  "dependencies": [
    "@tabler/icons-react"
  ],
  "registryDependencies": [
    "@usespaceui/hooks-browser-use-share",
    "@usespaceui/primitives-badge",
    "@usespaceui/primitives-button",
    "@usespaceui/primitives-card"
  ],
  "files": [
    {
      "path": "src/registry/demo/hooks/browser/share/h-share-01/index.tsx",
      "content": "'use client'\n\nimport * as React from 'react'\nimport { useShare } from '@/hooks/use-share'\nimport { Card, CardPanel } from '@/components/ui/card'\nimport { Button } from '@/components/ui/button'\nimport { Badge } from '@/components/ui/badge'\nimport { IconShare } from '@tabler/icons-react'\n\nexport default function Demo() {\n  const [share, { isSupported }] = useShare()\n\n  return (\n    <Card className=\"w-full max-w-md bg-muted rounded-2xl overflow-hidden\">\n      <div className=\"flex items-center justify-between gap-3 px-3 pt-1 pb-1\">\n        <div className=\"flex items-center gap-2 text-sm font-semibold text-foreground\">\n          <Badge variant=\"secondary\" className=\"rounded-sm aspect-square h-full! bg-transparent\">\n            <IconShare className=\"size-4 text-muted-foreground\" />\n          </Badge>\n          <span>Share</span>\n        </div>\n        <Badge variant={isSupported ? 'success' : 'outline'} size=\"sm\">\n          {isSupported ? 'Ready' : 'Unsupported'}\n        </Badge>\n      </div>\n      <CardPanel className=\"flex flex-col gap-3 rounded-[0.875rem] bg-background p-3\">\n        <Button onClick={() => share({ title: 'Space UI', url: 'https://space-ui.com' })} disabled={!isSupported}>\n          <IconShare className=\"size-3.5\" />\n          Share\n        </Button>\n      </CardPanel>\n    </Card>\n  )\n}\n",
      "type": "registry:hook",
      "target": "components/spaceui/share.tsx"
    }
  ],
  "categories": [
    "hooks",
    "browser",
    "share"
  ],
  "type": "registry:hook"
}