{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "demo-h-auto-height-01",
  "title": "useAutoHeight",
  "description": "Dynamic container height transition",
  "dependencies": [
    "@tabler/icons-react"
  ],
  "registryDependencies": [
    "https://www.spaceui.one/r/hooks-animation-use-auto-height.json",
    "https://www.spaceui.one/r/primitives-badge.json",
    "https://www.spaceui.one/r/primitives-button.json",
    "https://www.spaceui.one/r/primitives-card.json"
  ],
  "files": [
    {
      "path": "src/registry/demo/hooks/animation/auto-height/h-auto-height-01/index.tsx",
      "content": "'use client'\n\nimport * as React from 'react'\nimport { useAutoHeight } from '@/hooks/use-auto-height'\nimport { Card, CardPanel } from '@/components/ui/card'\nimport { Button } from '@/components/ui/button'\nimport { Badge } from '@/components/ui/badge'\nimport { IconArrowsVertical, IconPlus, IconMinus } from '@tabler/icons-react'\n\nexport default function Demo() {\n  const [items, setItems] = React.useState([\n    'Item 1: Smooth CSS height interpolation',\n    'Item 2: Driven by ResizeObserver & RAF',\n  ])\n  const { ref, height } = useAutoHeight([items])\n\n  return (\n    <Card className=\"w-full max-w-md bg-muted rounded-2xl overflow-hidden\">\n      <div className=\"flex items-center justify-between gap-3 px-3 pt-1 pb-1\">\n        <div className=\"flex items-center gap-2 text-sm font-semibold text-foreground\">\n          <Badge variant=\"secondary\" className=\"rounded-sm aspect-square h-full! bg-transparent\">\n            <IconArrowsVertical className=\"size-4 text-muted-foreground\" />\n          </Badge>\n          <span>Height</span>\n        </div>\n        <Badge variant=\"outline\" size=\"sm\" className=\"font-mono tabular-nums\">\n          {Math.round(height)}px\n        </Badge>\n      </div>\n      <CardPanel className=\"flex flex-col gap-3 rounded-[0.875rem] bg-background p-3\">\n        <div className=\"flex items-center gap-2\">\n          <Button\n            size=\"sm\"\n            variant=\"outline\"\n            onClick={() => setItems((p) => [...p, `Item ${p.length + 1}: Dynamic list item`])}\n          >\n            <IconPlus className=\"size-3.5\" />\n            Add\n          </Button>\n          <Button\n            size=\"sm\"\n            variant=\"outline\"\n            onClick={() => setItems((p) => p.slice(0, -1))}\n            disabled={items.length <= 1}\n          >\n            <IconMinus className=\"size-3.5\" />\n            Remove\n          </Button>\n        </div>\n        <div\n          style={{ height }}\n          className=\"overflow-hidden rounded-lg bg-muted transition-[height] duration-300 ease-out\"\n        >\n          <div ref={ref} className=\"flex flex-col gap-2 p-2\">\n            {items.map((it, i) => (\n              <div key={i} className=\"rounded-lg bg-background p-2.5 text-sm font-medium text-foreground\">\n                {it}\n              </div>\n            ))}\n          </div>\n        </div>\n      </CardPanel>\n    </Card>\n  )\n}\n",
      "type": "registry:hook",
      "target": "components/spaceui/auto-height.tsx"
    }
  ],
  "categories": [
    "hooks",
    "animation",
    "auto-height"
  ],
  "type": "registry:hook"
}