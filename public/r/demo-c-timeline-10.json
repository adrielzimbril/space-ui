{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "demo-c-timeline-10",
  "title": "Deployment log timeline",
  "description": "Deployment log timeline",
  "dependencies": [
    "@tabler/icons-react"
  ],
  "registryDependencies": [
    "https://www.spaceui.one/r/components-spaceui-timeline.json",
    "https://www.spaceui.one/r/lib-utils.json",
    "https://www.spaceui.one/r/primitives-badge.json"
  ],
  "files": [
    {
      "path": "src/registry/demo/components/spaceui/timeline/c-timeline-10/index.tsx",
      "content": "'use client'\n\nimport { IconCheck, IconX } from '@tabler/icons-react'\nimport { Badge } from '@/components/ui/badge'\nimport {\n  Timeline,\n  TimelineContent,\n  TimelineDate,\n  TimelineHeader,\n  TimelineIndicator,\n  TimelineItem,\n  TimelineSeparator,\n  TimelineTitle,\n} from '@/components/spaceui/timeline'\n\nimport { cn } from '@/lib/utils'\nconst deployments = [\n  {\n    id: 1,\n    title: 'Production Deploy',\n    date: '2 minutes ago',\n    commit: 'a1b2c3d',\n    branch: 'main',\n    status: 'success',\n    duration: '42s',\n  },\n  {\n    id: 2,\n    title: 'Staging Deploy',\n    date: '15 minutes ago',\n    commit: 'e4f5g6h',\n    branch: 'staging',\n    status: 'success',\n    duration: '38s',\n  },\n  {\n    id: 3,\n    title: 'Preview Deploy',\n    date: '1 hour ago',\n    commit: 'i7j8k9l',\n    branch: 'feat/auth',\n    status: 'failed',\n    duration: '1m 12s',\n  },\n  {\n    id: 4,\n    title: 'Production Deploy',\n    date: '3 hours ago',\n    commit: 'm0n1o2p',\n    branch: 'main',\n    status: 'success',\n    duration: '45s',\n  },\n]\n\nexport default function Demo() {\n  return (\n    <div className=\"w-full max-w-xs\">\n      <Timeline defaultValue={4}>\n        {deployments.map((deploy) => (\n          <TimelineItem key={deploy.id} step={deploy.id} className=\"group-data-[orientation=vertical]/timeline:ms-10\">\n            <TimelineHeader>\n              <TimelineSeparator className=\"bg-input! group-data-[orientation=vertical]/timeline:-left-7 group-data-[orientation=vertical]/timeline:h-[calc(100%-1.5rem-0.25rem)] group-data-[orientation=vertical]/timeline:translate-y-6.5\" />\n              <div className=\"flex items-center gap-2\">\n                <TimelineTitle className=\"text-sm\">{deploy.title}</TimelineTitle>\n                <Badge variant={deploy.status === 'success' ? 'success' : 'destructive'} size=\"sm\">\n                  {deploy.status}\n                </Badge>\n              </div>\n              <TimelineIndicator\n                className={cn(\n                  'flex size-6 items-center justify-center border-none group-data-[orientation=vertical]/timeline:-left-7',\n                  deploy.status === 'success' ? 'bg-emerald-500 text-white' : 'bg-destructive text-white',\n                )}\n              >\n                {deploy.status === 'success' ? <IconCheck className=\"size-3.5\" /> : <IconX className=\"size-3.5\" />}\n              </TimelineIndicator>\n            </TimelineHeader>\n            <TimelineContent>\n              <div className=\"text-muted-foreground flex items-center gap-3 text-xs\">\n                <span className=\"font-mono\">{deploy.commit}</span>\n                <span>&middot;</span>\n                <span>{deploy.branch}</span>\n                <span>&middot;</span>\n                <span>{deploy.duration}</span>\n              </div>\n              <TimelineDate className=\"mt-1 mb-0\">{deploy.date}</TimelineDate>\n            </TimelineContent>\n          </TimelineItem>\n        ))}\n      </Timeline>\n    </div>\n  )\n}\n",
      "type": "registry:component",
      "target": "components/spaceui/timeline.tsx"
    }
  ],
  "categories": [
    "component",
    "timeline"
  ],
  "type": "registry:component"
}