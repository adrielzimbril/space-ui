{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "demo-h-single-effect-01",
  "title": "useSingleEffect",
  "description": "Guaranteed exactly-once execution effect",
  "dependencies": [
    "@tabler/icons-react"
  ],
  "registryDependencies": [
    "https://www.spaceui.one/r/hooks-lifecycle-use-single-effect.json",
    "https://www.spaceui.one/r/primitives-badge.json",
    "https://www.spaceui.one/r/primitives-card.json"
  ],
  "files": [
    {
      "path": "src/registry/demo/hooks/lifecycle/single-effect/h-single-effect-01/index.tsx",
      "content": "'use client'\n\nimport * as React from 'react'\nimport { useSingleEffect } from '@/hooks/use-single-effect'\nimport { Card, CardPanel } from '@/components/ui/card'\nimport { Badge } from '@/components/ui/badge'\nimport { IconShieldCheck } from '@tabler/icons-react'\n\nexport default function Demo() {\n  const [times, setTimes] = React.useState(0)\n  useSingleEffect(() => {\n    setTimes((t) => t + 1)\n  })\n\n  return (\n    <Card className=\"w-full max-w-md bg-muted rounded-2xl overflow-hidden\">\n      <div className=\"flex items-center justify-between gap-3 px-3 pt-1 pb-1\">\n        <div className=\"flex items-center gap-2 text-sm font-semibold text-foreground\">\n          <Badge variant=\"secondary\" className=\"rounded-sm aspect-square h-full! bg-transparent\">\n            <IconShieldCheck className=\"size-4 text-muted-foreground\" />\n          </Badge>\n          <span>Single</span>\n        </div>\n        <Badge variant=\"default\" size=\"sm\" className=\"font-mono tabular-nums\">\n          {times}x\n        </Badge>\n      </div>\n      <CardPanel className=\"flex items-center justify-between rounded-[0.875rem] bg-background p-3\">\n        <span className=\"text-sm text-muted-foreground\">StrictMode runs</span>\n        <span className=\"font-mono text-sm font-semibold tabular-nums text-foreground\">{times}</span>\n      </CardPanel>\n    </Card>\n  )\n}\n",
      "type": "registry:hook",
      "target": "components/spaceui/single-effect.tsx"
    }
  ],
  "categories": [
    "hooks",
    "lifecycle",
    "single-effect"
  ],
  "type": "registry:hook"
}