{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "demo-h-is-mac-01",
  "title": "useIsMac",
  "description": "macOS platform detector",
  "dependencies": [
    "@tabler/icons-react"
  ],
  "registryDependencies": [
    "https://www.spaceui.one/r/hooks-browser-use-is-mac.json",
    "https://www.spaceui.one/r/primitives-badge.json",
    "https://www.spaceui.one/r/primitives-card.json",
    "https://www.spaceui.one/r/primitives-kbd.json"
  ],
  "files": [
    {
      "path": "src/registry/demo/hooks/browser/is-mac/h-is-mac-01/index.tsx",
      "content": "'use client'\n\nimport * as React from 'react'\nimport { useIsMac } from '@/hooks/use-is-mac'\nimport { Card, CardPanel } from '@/components/ui/card'\nimport { Badge } from '@/components/ui/badge'\nimport { Kbd } from '@/components/ui/kbd'\nimport { IconBrandApple, IconDeviceDesktop } from '@tabler/icons-react'\n\nexport default function Demo() {\n  const isMac = useIsMac()\n\n  return (\n    <Card className=\"w-full max-w-md bg-muted rounded-2xl overflow-hidden\">\n      <div className=\"flex items-center justify-between gap-3 px-3 pt-1 pb-1\">\n        <div className=\"flex items-center gap-2 text-sm font-semibold text-foreground\">\n          <Badge variant=\"secondary\" className=\"rounded-sm aspect-square h-full! bg-transparent\">\n            {isMac ? (\n              <IconBrandApple className=\"size-4 text-muted-foreground\" />\n            ) : (\n              <IconDeviceDesktop className=\"size-4 text-muted-foreground\" />\n            )}\n          </Badge>\n          <span>Platform</span>\n        </div>\n        <Badge variant={isMac ? 'success' : 'outline'} size=\"sm\">\n          {isMac ? 'macOS' : 'Other'}\n        </Badge>\n      </div>\n      <CardPanel className=\"flex flex-col gap-3 rounded-[0.875rem] bg-background p-3\">\n        <div className=\"rounded-lg bg-muted p-2.5\">\n          <span className=\"block text-[.6875rem] font-semibold text-muted-foreground\">Modifier</span>\n          <span className=\"mt-0.5 block font-mono text-sm font-semibold text-foreground\">\n            <Kbd>{isMac ? '⌘' : 'Ctrl'}</Kbd>\n          </span>\n        </div>\n      </CardPanel>\n    </Card>\n  )\n}\n",
      "type": "registry:hook",
      "target": "components/spaceui/is-mac.tsx"
    }
  ],
  "categories": [
    "hooks",
    "browser",
    "is-mac"
  ],
  "type": "registry:hook"
}