{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "demo-hooks-utils-sleep-1",
  "title": "sleep",
  "description": "Promise-based delay timer",
  "dependencies": [
    "@tabler/icons-react"
  ],
  "registryDependencies": [
    "@usespaceui/hooks-utils-sleep",
    "@usespaceui/primitives-badge",
    "@usespaceui/primitives-button",
    "@usespaceui/primitives-card"
  ],
  "files": [
    {
      "path": "src/registry/demo/hooks/utils/sleep/h-sleep-1/index.tsx",
      "content": "'use client'\n\nimport * as React from 'react'\nimport { sleep } from '@/utils/sleep'\nimport { Card, CardPanel } from '@/components/ui/card'\nimport { Button } from '@/components/ui/button'\nimport { Badge } from '@/components/ui/badge'\nimport { IconHourglass, IconLoader2 } from '@tabler/icons-react'\n\nexport default function Demo() {\n  const [sleeping, setSleeping] = React.useState(false)\n\n  const run = async () => {\n    setSleeping(true)\n    await sleep(1500)\n    setSleeping(false)\n  }\n\n  return (\n    <Card className=\"w-full max-w-md bg-muted rounded-2xl overflow-hidden\">\n      <div className=\"flex items-center justify-between gap-3 px-3 pt-1 pb-1\">\n        <div className=\"flex items-center gap-2 text-sm font-semibold text-foreground\">\n          <Badge variant=\"secondary\" className=\"rounded-sm aspect-square h-full! bg-transparent\">\n            <IconHourglass className=\"size-4 text-muted-foreground\" />\n          </Badge>\n          <span>Sleep</span>\n        </div>\n        <Badge variant={sleeping ? 'default' : 'outline'} size=\"sm\">\n          {sleeping ? 'Waiting' : 'Idle'}\n        </Badge>\n      </div>\n      <CardPanel className=\"flex items-center justify-between rounded-[0.875rem] bg-background p-3\">\n        <span className=\"font-mono text-xs tabular-nums text-muted-foreground\">1500ms</span>\n        <Button size=\"sm\" onClick={run} disabled={sleeping}>\n          {sleeping ? <IconLoader2 className=\"size-3.5 animate-spin\" /> : null}\n          {sleeping ? 'Waiting' : 'Delay'}\n        </Button>\n      </CardPanel>\n    </Card>\n  )\n}\n",
      "type": "registry:hook",
      "target": "components/spaceui/h-sleep-1.tsx"
    }
  ],
  "categories": [
    "hooks",
    "utils",
    "sleep"
  ],
  "type": "registry:hook"
}