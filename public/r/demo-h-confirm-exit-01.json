{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "demo-h-confirm-exit-01",
  "title": "useConfirmExit",
  "description": "Unsaved changes tab exit guard",
  "dependencies": [
    "@tabler/icons-react"
  ],
  "registryDependencies": [
    "https://www.spaceui.one/r/hooks-lifecycle-use-confirm-exit.json",
    "https://www.spaceui.one/r/primitives-badge.json",
    "https://www.spaceui.one/r/primitives-button.json",
    "https://www.spaceui.one/r/primitives-card.json"
  ],
  "files": [
    {
      "path": "src/registry/demo/hooks/lifecycle/confirm-exit/h-confirm-exit-01/index.tsx",
      "content": "'use client'\n\nimport * as React from 'react'\nimport { useConfirmExit } from '@/hooks/use-confirm-exit'\nimport { Card, CardPanel } from '@/components/ui/card'\nimport { Button } from '@/components/ui/button'\nimport { Badge } from '@/components/ui/badge'\nimport { IconDoorExit } from '@tabler/icons-react'\n\nexport default function Demo() {\n  const [dirty, setDirty] = React.useState(false)\n  useConfirmExit(dirty, 'You have unsaved changes.')\n\n  return (\n    <Card className=\"w-full max-w-md bg-muted rounded-2xl overflow-hidden\">\n      <div className=\"flex items-center justify-between gap-3 px-3 pt-1 pb-1\">\n        <div className=\"flex items-center gap-2 text-sm font-semibold text-foreground\">\n          <Badge variant=\"secondary\" className=\"rounded-sm aspect-square h-full! bg-transparent\">\n            <IconDoorExit className=\"size-4 text-muted-foreground\" />\n          </Badge>\n          <span>Exit Guard</span>\n        </div>\n        <Badge variant={dirty ? 'warning' : 'outline'} size=\"sm\">\n          {dirty ? 'Unsaved' : 'Saved'}\n        </Badge>\n      </div>\n      <CardPanel className=\"flex items-center justify-between rounded-[0.875rem] bg-background p-3\">\n        <span className=\"text-sm text-muted-foreground\">{dirty ? 'Warns on close' : 'Safe to close'}</span>\n        <Button size=\"sm\" variant={dirty ? 'secondary' : 'default'} onClick={() => setDirty((d) => !d)}>\n          {dirty ? 'Save' : 'Edit'}\n        </Button>\n      </CardPanel>\n    </Card>\n  )\n}\n",
      "type": "registry:hook",
      "target": "components/spaceui/confirm-exit.tsx"
    }
  ],
  "categories": [
    "hooks",
    "lifecycle",
    "confirm-exit"
  ],
  "type": "registry:hook"
}