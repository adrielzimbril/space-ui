{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "demo-h-is-negative-01",
  "title": "isNegative",
  "description": "Negative numeric check",
  "dependencies": [
    "@tabler/icons-react"
  ],
  "registryDependencies": [
    "https://www.spaceui.one/r/hooks-utils-is-negative.json",
    "https://www.spaceui.one/r/primitives-badge.json",
    "https://www.spaceui.one/r/primitives-card.json",
    "https://www.spaceui.one/r/primitives-input.json"
  ],
  "files": [
    {
      "path": "src/registry/demo/hooks/utils/is-negative/h-is-negative-01/index.tsx",
      "content": "'use client'\n\nimport * as React from 'react'\nimport { isNegative } from '@/utils/is-negative'\nimport { Card, CardPanel } from '@/components/ui/card'\nimport { Badge } from '@/components/ui/badge'\nimport { Input } from '@/components/ui/input'\nimport { IconMath } from '@tabler/icons-react'\n\nexport default function Demo() {\n  const [num, setNum] = React.useState('-42')\n  const isNeg = isNegative(Number(num))\n\n  return (\n    <Card className=\"w-full max-w-md bg-muted rounded-2xl overflow-hidden\">\n      <div className=\"flex items-center justify-between gap-3 px-3 pt-1 pb-1\">\n        <div className=\"flex items-center gap-2 text-sm font-semibold text-foreground\">\n          <Badge variant=\"secondary\" className=\"rounded-sm aspect-square h-full! bg-transparent\">\n            <IconMath className=\"size-4 text-muted-foreground\" />\n          </Badge>\n          <span>Sign</span>\n        </div>\n        <Badge variant={isNeg ? 'destructive' : 'outline'} size=\"sm\">\n          {isNeg ? 'Negative' : 'Positive'}\n        </Badge>\n      </div>\n      <CardPanel className=\"flex items-center gap-2 rounded-[0.875rem] bg-background p-3\">\n        <Input\n          value={num}\n          onChange={(e) => setNum(e.target.value)}\n          className=\"font-mono text-base sm:text-sm\"\n          placeholder=\"0\"\n          aria-label=\"Number to check\"\n        />\n        <Badge variant={isNeg ? 'destructive' : 'default'} size=\"sm\" className=\"shrink-0\">\n          {isNeg ? 'Negative' : 'Positive / Zero'}\n        </Badge>\n      </CardPanel>\n    </Card>\n  )\n}\n",
      "type": "registry:hook",
      "target": "components/spaceui/is-negative.tsx"
    }
  ],
  "categories": [
    "hooks",
    "utils",
    "is-negative"
  ],
  "type": "registry:hook"
}