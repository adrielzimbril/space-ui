{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "demo-hooks-lifecycle-interval-2",
  "title": "useInterval (Server Polling Simulator)",
  "description": "Polling simulator with configurable delay",
  "dependencies": [
    "@tabler/icons-react"
  ],
  "registryDependencies": [
    "@usespaceui/hooks-lifecycle-use-interval",
    "@usespaceui/primitives-badge",
    "@usespaceui/primitives-button",
    "@usespaceui/primitives-card"
  ],
  "files": [
    {
      "path": "src/registry/demo/hooks/lifecycle/interval/h-interval-2/index.tsx",
      "content": "'use client'\n\nimport * as React from 'react'\nimport { useInterval } from '@/hooks/use-interval'\nimport { Card, CardPanel } from '@/components/ui/card'\nimport { Badge } from '@/components/ui/badge'\nimport { Button } from '@/components/ui/button'\nimport { IconServer } from '@tabler/icons-react'\n\nexport default function Demo() {\n  const [requests, setRequests] = React.useState(0)\n  const [delay, setDelay] = React.useState<number | null>(1500)\n  const [lastSync, setLastSync] = React.useState<string>('Never')\n\n  const { start, stop } = useInterval(() => {\n    setRequests((r) => r + 1)\n    setLastSync(new Date().toLocaleTimeString())\n  }, delay ?? 1500)\n\n  return (\n    <Card className=\"w-full max-w-md bg-muted rounded-2xl overflow-hidden\">\n      <div className=\"flex items-center justify-between gap-3 px-3 pt-1 pb-1\">\n        <div className=\"flex items-center gap-2 text-sm font-semibold text-foreground\">\n          <Badge variant=\"secondary\" className=\"rounded-sm aspect-square h-full! bg-transparent\">\n            <IconServer className=\"size-4 text-muted-foreground\" />\n          </Badge>\n          <span>Polling</span>\n        </div>\n        <Badge variant={delay ? 'default' : 'outline'} size=\"sm\" className=\"font-mono tabular-nums\">\n          {delay ? `${delay}ms` : 'Paused'}\n        </Badge>\n      </div>\n      <CardPanel className=\"flex flex-col gap-3 rounded-[0.875rem] bg-background p-3\">\n        <div className=\"grid grid-cols-2 gap-2\">\n          <div className=\"rounded-lg bg-muted p-2.5\">\n            <span className=\"block text-[.6875rem] font-semibold text-muted-foreground\">Requests</span>\n            <span className=\"mt-0.5 block font-mono text-sm font-semibold tabular-nums text-foreground\">\n              {requests}\n            </span>\n          </div>\n          <div className=\"rounded-lg bg-muted p-2.5\">\n            <span className=\"block text-[.6875rem] font-semibold text-muted-foreground\">Last sync</span>\n            <span className=\"mt-0.5 block font-mono text-sm font-semibold tabular-nums text-foreground\">\n              {lastSync}\n            </span>\n          </div>\n        </div>\n        <div className=\"flex gap-2\">\n          <Button\n            size=\"sm\"\n            variant={delay === 1000 ? 'default' : 'outline'}\n            onClick={() => {\n              setDelay(1000)\n              start(1000)\n            }}\n            className=\"flex-1\"\n          >\n            Poll 1s\n          </Button>\n          <Button\n            size=\"sm\"\n            variant={delay === 3000 ? 'default' : 'outline'}\n            onClick={() => {\n              setDelay(3000)\n              start(3000)\n            }}\n            className=\"flex-1\"\n          >\n            Poll 3s\n          </Button>\n          <Button\n            size=\"sm\"\n            variant=\"destructive\"\n            onClick={() => {\n              setDelay(null)\n              stop()\n            }}\n            className=\"flex-1\"\n          >\n            Pause\n          </Button>\n        </div>\n      </CardPanel>\n    </Card>\n  )\n}\n",
      "type": "registry:hook",
      "target": "components/spaceui/h-interval-2.tsx"
    }
  ],
  "categories": [
    "hooks",
    "lifecycle",
    "interval"
  ],
  "type": "registry:hook"
}