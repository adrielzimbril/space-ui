      "content": "import { Select, SelectItem, SelectPopup, SelectTrigger, SelectValue } from '@/components/ui/select'\n\nexport default function Particle() {\n  return (\n    <div className=\"flex w-full max-w-sm flex-col gap-3\">\n      <Select defaultValue=\"apple\">\n        <SelectTrigger size=\"sm\">\n          <SelectValue placeholder=\"Select fruit (sm)\" />\n        </SelectTrigger>\n        <SelectPopup>\n          <SelectItem value=\"apple\">Apple</SelectItem>\n          <SelectItem value=\"banana\">Banana</SelectItem>\n          <SelectItem value=\"orange\">Orange</SelectItem>\n        </SelectPopup>\n      </Select>\n\n      <Select defaultValue=\"apple\">\n        <SelectTrigger size=\"default\">\n          <SelectValue placeholder=\"Select fruit (default)\" />\n        </SelectTrigger>\n        <SelectPopup>\n          <SelectItem value=\"apple\">Apple</SelectItem>\n          <SelectItem value=\"banana\">Banana</SelectItem>\n          <SelectItem value=\"orange\">Orange</SelectItem>\n        </SelectPopup>\n      </Select>\n\n      <Select defaultValue=\"apple\">\n        <SelectTrigger size=\"lg\">\n          <SelectValue placeholder=\"Select fruit (lg)\" />\n        </SelectTrigger>\n        <SelectPopup>\n          <SelectItem value=\"apple\">Apple</SelectItem>\n          <SelectItem value=\"banana\">Banana</SelectItem>\n          <SelectItem value=\"orange\">Orange</SelectItem>\n        </SelectPopup>\n      </Select>\n    </div>\n  )\n}\n",
      "type": "registry:ui",
      "target": "components/spaceui/select.tsx"
    }
