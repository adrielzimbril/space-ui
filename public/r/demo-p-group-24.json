{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "demo-p-group-24",
  "title": "Publish controls with split button and overflow",
  "description": "Publish controls with split button and overflow",
  "dependencies": [
    "@tabler/icons-react"
  ],
  "registryDependencies": [
    "https://www.spaceui.one/r/components-spaceui-avatar-group.json",
    "https://www.spaceui.one/r/primitives-avatar.json",
    "https://www.spaceui.one/r/primitives-button.json",
    "https://www.spaceui.one/r/primitives-group.json",
    "https://www.spaceui.one/r/primitives-menu.json",
    "https://www.spaceui.one/r/primitives-separator.json"
  ],
  "files": [
    {
      "path": "src/registry/demo/primitives/group/p-group-24/index.tsx",
      "content": "import {\n  IconEye,\n  IconSend,\n  IconChevronDown,\n  IconCalendar,\n  IconFile,\n  IconDots,\n  IconCopy,\n  IconHistory,\n  IconArchive,\n  IconTrash,\n} from '@tabler/icons-react'\nimport { Avatar, AvatarFallback, AvatarImage } from '@/components/ui/avatar'\nimport { AvatarGroup } from '@/components/spaceui/avatar-group'\nimport { Button } from '@/components/ui/button'\nimport { Group, GroupSeparator } from '@/components/ui/group'\nimport { Menu, MenuPopup, MenuGroup, MenuItem, MenuSeparator, MenuTrigger } from '@/components/ui/menu'\nimport { Separator } from '@/components/ui/separator'\nconst viewers = [\n  {\n    src: 'https://avatars.spaceui.one/v1?name=uranus&variant=triton',\n    initials: 'SC',\n    name: 'Sarah Chen',\n  },\n  {\n    src: 'https://avatars.spaceui.one/v1?name=earth&variant=solar-flare',\n    initials: 'AJ',\n    name: 'Alex Johnson',\n  },\n]\n\nexport default function Demo() {\n  return (\n    <div className=\"flex shrink-0 items-center gap-2\">\n      <AvatarGroup>\n        {viewers.map((viewer) => (\n          <Avatar key={viewer.name} className=\"size-8 text-xs\">\n            <AvatarImage src={viewer.src} alt={viewer.name} />\n            <AvatarFallback>{viewer.initials}</AvatarFallback>\n          </Avatar>\n        ))}\n      </AvatarGroup>\n\n      <Separator orientation=\"vertical\" className=\"my-auto h-4\" />\n\n      <Button variant=\"outline\" size=\"sm\">\n        <IconEye aria-hidden=\"true\" />\n        <span className=\"hidden md:block\">Preview</span>\n      </Button>\n\n      <Group className=\"**:data-[slot=button]:border-r-0\">\n        <Button size=\"sm\">\n          <IconSend aria-hidden=\"true\" />\n          Publish\n        </Button>\n\n        <GroupSeparator className=\"bg-primary/72\" />\n\n        <Menu>\n          <MenuTrigger\n            render={\n              <Button\n                size=\"icon-sm\"\n                className=\"border-primary-foreground/20 rounded-l-none border-l\"\n                aria-label=\"More publish options\"\n              />\n            }\n          >\n            <IconChevronDown aria-hidden=\"true\" />\n          </MenuTrigger>\n\n          <MenuPopup sideOffset={8} align=\"end\" className=\"w-48\">\n            <MenuGroup>\n              <MenuItem>\n                <IconCalendar className=\"size-4 opacity-60\" aria-hidden=\"true\" />\n                Schedule for later\n              </MenuItem>\n              <MenuItem>\n                <IconFile className=\"size-4 opacity-60\" aria-hidden=\"true\" />\n                Save as draft\n              </MenuItem>\n            </MenuGroup>\n          </MenuPopup>\n        </Menu>\n      </Group>\n\n      <Menu>\n        <MenuTrigger render={<Button variant=\"ghost\" size=\"icon-sm\" aria-label=\"More actions\" />}>\n          <IconDots aria-hidden=\"true\" />\n        </MenuTrigger>\n\n        <MenuPopup sideOffset={8} align=\"end\" className=\"w-40\">\n          <MenuGroup>\n            <MenuItem>\n              <IconCopy className=\"size-4 opacity-60\" aria-hidden=\"true\" />\n              Duplicate\n            </MenuItem>\n            <MenuItem>\n              <IconHistory className=\"size-4 opacity-60\" aria-hidden=\"true\" />\n              View history\n            </MenuItem>\n            <MenuItem>\n              <IconArchive className=\"size-4 opacity-60\" aria-hidden=\"true\" />\n              Archive\n            </MenuItem>\n            <MenuSeparator />\n            <MenuItem variant=\"destructive\">\n              <IconTrash aria-hidden=\"true\" />\n              Delete\n            </MenuItem>\n          </MenuGroup>\n        </MenuPopup>\n      </Menu>\n    </div>\n  )\n}\n",
      "type": "registry:ui",
      "target": "components/spaceui/group.tsx"
    }
  ],
  "categories": [
    "button-group"
  ],
  "type": "registry:ui"
}