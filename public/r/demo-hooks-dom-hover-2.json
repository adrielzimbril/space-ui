{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "demo-hooks-dom-hover-2",
  "title": "useHover (External Ref)",
  "description": "Hover state detection using an explicit external React ref",
  "dependencies": [
    "@tabler/icons-react"
  ],
  "registryDependencies": [
    "@usespaceui/hooks-dom-use-hover",
    "@usespaceui/primitives-badge",
    "@usespaceui/primitives-button",
    "@usespaceui/primitives-card"
  ],
  "files": [
    {
      "path": "src/registry/demo/hooks/dom/hover/h-hover-2/index.tsx",
      "content": "'use client'\n\nimport * as React from 'react'\nimport { useHover } from '@/hooks/use-hover'\nimport { Card, CardPanel } from '@/components/ui/card'\nimport { Button } from '@/components/ui/button'\nimport { Badge } from '@/components/ui/badge'\nimport { IconPackage } from '@tabler/icons-react'\n\nexport default function Demo() {\n  const cardRef = React.useRef<HTMLDivElement>(null)\n  const isHovered = useHover(cardRef)\n\n  return (\n    <Card className=\"w-full max-w-md bg-muted rounded-2xl overflow-hidden\">\n      <div className=\"flex items-center justify-between gap-3 px-3 pt-1 pb-1\">\n        <div className=\"flex items-center gap-2 text-sm font-semibold text-foreground\">\n          <Badge variant=\"secondary\" className=\"rounded-sm aspect-square h-full! bg-transparent\">\n            <IconPackage className=\"size-4 text-muted-foreground\" />\n          </Badge>\n          <span>Target</span>\n        </div>\n        <Badge variant={isHovered ? 'success' : 'outline'} size=\"sm\">\n          {isHovered ? 'Active' : 'Idle'}\n        </Badge>\n      </div>\n      <CardPanel className=\"rounded-[0.875rem] bg-background p-3\">\n        <div ref={cardRef} className=\"flex flex-col gap-3 rounded-lg bg-muted p-2.5\">\n          <span className=\"text-sm font-semibold text-foreground\">Observed</span>\n          <Button size=\"sm\" variant={isHovered ? 'default' : 'outline'} className=\"w-full\">\n            Inspect\n          </Button>\n        </div>\n      </CardPanel>\n    </Card>\n  )\n}\n",
      "type": "registry:hook",
      "target": "components/spaceui/h-hover-2.tsx"
    }
  ],
  "categories": [
    "hooks",
    "dom",
    "hover"
  ],
  "type": "registry:hook"
}