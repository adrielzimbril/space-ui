{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "demo-h-performance-mode-01",
  "title": "usePerformanceMode",
  "description": "Battery/CPU low-power mode optimizer",
  "dependencies": [
    "@tabler/icons-react"
  ],
  "registryDependencies": [
    "@usespaceui/hooks-lifecycle-use-performance-mode",
    "@usespaceui/primitives-badge",
    "@usespaceui/primitives-card"
  ],
  "files": [
    {
      "path": "src/registry/demo/hooks/lifecycle/performance-mode/h-performance-mode-01/index.tsx",
      "content": "'use client'\n\nimport * as React from 'react'\nimport { usePerformanceMode } from '@/hooks/use-performance-mode'\nimport { Card, CardPanel } from '@/components/ui/card'\nimport { Badge } from '@/components/ui/badge'\nimport { IconCpu, IconLeaf } from '@tabler/icons-react'\n\nexport default function Demo() {\n  const isEco = usePerformanceMode()\n\n  return (\n    <Card className=\"w-full max-w-md bg-muted rounded-2xl overflow-hidden\">\n      <div className=\"flex items-center justify-between gap-3 px-3 pt-1 pb-1\">\n        <div className=\"flex items-center gap-2 text-sm font-semibold text-foreground\">\n          <Badge variant=\"secondary\" className=\"rounded-sm aspect-square h-full! bg-transparent\">\n            {isEco ? (\n              <IconLeaf className=\"size-4 text-muted-foreground\" />\n            ) : (\n              <IconCpu className=\"size-4 text-muted-foreground\" />\n            )}\n          </Badge>\n          <span>Performance</span>\n        </div>\n        <Badge variant={isEco ? 'secondary' : 'default'} size=\"sm\">\n          {isEco ? 'Eco' : 'Full'}\n        </Badge>\n      </div>\n      <CardPanel className=\"flex items-center justify-between rounded-[0.875rem] bg-background p-3\">\n        <span className=\"text-sm text-muted-foreground\">Power profile</span>\n        <span className=\"text-sm font-semibold text-foreground\">{isEco ? 'Low power' : 'Full'}</span>\n      </CardPanel>\n    </Card>\n  )\n}\n",
      "type": "registry:hook",
      "target": "components/spaceui/performance-mode.tsx"
    }
  ],
  "categories": [
    "hooks",
    "lifecycle",
    "performance-mode"
  ],
  "type": "registry:hook"
}