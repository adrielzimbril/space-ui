{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "demo-h-lock-body-scroll-01",
  "title": "useLockBodyScroll",
  "description": "Lock page scrolling without layout shift",
  "dependencies": [
    "@tabler/icons-react"
  ],
  "registryDependencies": [
    "https://www.spaceui.one/r/hooks-dom-use-lock-body-scroll.json",
    "https://www.spaceui.one/r/primitives-badge.json",
    "https://www.spaceui.one/r/primitives-card.json",
    "https://www.spaceui.one/r/primitives-switch.json"
  ],
  "files": [
    {
      "path": "src/registry/demo/hooks/dom/lock-body-scroll/h-lock-body-scroll-01/index.tsx",
      "content": "'use client'\n\nimport * as React from 'react'\nimport { useLockBodyScroll } from '@/hooks/use-lock-body-scroll'\nimport { Card, CardPanel } from '@/components/ui/card'\nimport { Badge } from '@/components/ui/badge'\nimport { Switch } from '@/components/ui/switch'\nimport { IconLock } from '@tabler/icons-react'\n\nexport default function Demo() {\n  const { isLocked, toggle } = useLockBodyScroll(false)\n\n  return (\n    <Card className=\"w-full max-w-md bg-muted rounded-2xl overflow-hidden\">\n      <div className=\"flex items-center justify-between gap-3 px-3 pt-1 pb-1\">\n        <div className=\"flex items-center gap-2 text-sm font-semibold text-foreground\">\n          <Badge variant=\"secondary\" className=\"rounded-sm aspect-square h-full! bg-transparent\">\n            <IconLock className=\"size-4 text-muted-foreground\" />\n          </Badge>\n          <span>Lock</span>\n        </div>\n        <Badge variant={isLocked ? 'destructive' : 'outline'} size=\"sm\">\n          {isLocked ? 'Locked' : 'Unlocked'}\n        </Badge>\n      </div>\n      <CardPanel className=\"flex items-center justify-between rounded-[0.875rem] bg-background p-3\">\n        <span className=\"text-sm text-muted-foreground\">Body scroll</span>\n        <Switch checked={isLocked} onCheckedChange={toggle} aria-label=\"Lock body scroll\" />\n      </CardPanel>\n    </Card>\n  )\n}\n",
      "type": "registry:hook",
      "target": "components/spaceui/lock-body-scroll.tsx"
    }
  ],
  "categories": [
    "hooks",
    "dom",
    "lock-body-scroll"
  ],
  "type": "registry:hook"
}