{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "demo-p-select-13",
  "title": "Select 13",
  "description": "Status select with colored dot",
  "registryDependencies": [
    "https://www.spaceui.one/r/primitives-select.json"
  ],
  "files": [
    {
      "path": "src/registry/demo/primitives/select/p-select-13/index.tsx",
      "content": "'use client'\n\nimport { Select, SelectItem, SelectPopup, SelectTrigger, SelectValue } from '@/components/ui/select'\n\nconst items = [\n  { color: 'bg-emerald-500', label: 'Completed', value: 'completed' },\n  { color: 'bg-blue-500', label: 'In Progress', value: 'in-progress' },\n  { color: 'bg-amber-500', label: 'Pending', value: 'pending' },\n  { color: 'bg-gray-500', label: 'Cancelled', value: 'cancelled' },\n  { color: 'bg-red-500', label: 'Failed', value: 'failed' },\n]\n\nexport default function Demo() {\n  return (\n    <Select aria-label=\"Select status\" defaultValue={items[0]} itemToStringValue={(item) => item.value}>\n      <SelectTrigger>\n        <SelectValue>\n          {(item) => (\n            <span className=\"flex items-center gap-2\">\n              <span aria-hidden=\"true\" className={`size-2 rounded-full ${item.color}`} />\n              <span className=\"truncate\">{item.label}</span>\n            </span>\n          )}\n        </SelectValue>\n      </SelectTrigger>\n      <SelectPopup>\n        {items.map((item) => (\n          <SelectItem key={item.value} value={item}>\n            <span className=\"flex items-center gap-2\">\n              <span aria-hidden=\"true\" className={`size-2 rounded-full ${item.color}`} />\n              <span className=\"truncate\">{item.label}</span>\n            </span>\n          </SelectItem>\n        ))}\n      </SelectPopup>\n    </Select>\n  )\n}\n",
      "type": "registry:ui",
      "target": "components/spaceui/select.tsx"
    }
  ],
  "categories": [
    "select"
  ],
  "type": "registry:ui"
}