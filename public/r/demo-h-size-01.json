{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "demo-h-size-01",
  "title": "useSize",
  "description": "Measure element width & height in real time",
  "dependencies": [
    "@tabler/icons-react"
  ],
  "registryDependencies": [
    "@usespaceui/hooks-dom-use-size",
    "@usespaceui/primitives-badge",
    "@usespaceui/primitives-card"
  ],
  "files": [
    {
      "path": "src/registry/demo/hooks/dom/size/h-size-01/index.tsx",
      "content": "'use client'\n\nimport * as React from 'react'\nimport { useSize } from '@/hooks/use-size'\nimport { Card, CardPanel } from '@/components/ui/card'\nimport { Badge } from '@/components/ui/badge'\nimport { IconDimensions } from '@tabler/icons-react'\n\nexport default function Demo() {\n  const ref = React.useRef<HTMLDivElement>(null)\n  const size = useSize(ref)\n\n  return (\n    <Card className=\"w-full max-w-md bg-muted rounded-2xl overflow-hidden\">\n      <div className=\"flex items-center justify-between gap-3 px-3 pt-1 pb-1\">\n        <div className=\"flex items-center gap-2 text-sm font-semibold text-foreground\">\n          <Badge variant=\"secondary\" className=\"rounded-sm aspect-square h-full! bg-transparent\">\n            <IconDimensions className=\"size-4 text-muted-foreground\" />\n          </Badge>\n          <span>Size</span>\n        </div>\n        <Badge variant=\"outline\" size=\"sm\" className=\"font-mono tabular-nums\">\n          {Math.round(size.width)} × {Math.round(size.height)}\n        </Badge>\n      </div>\n      <CardPanel className=\"rounded-[0.875rem] bg-background p-3\">\n        <div\n          ref={ref}\n          className=\"flex h-24 items-center justify-center rounded-lg bg-muted font-mono text-sm font-semibold tabular-nums text-foreground\"\n        >\n          {Math.round(size.width)} × {Math.round(size.height)}\n        </div>\n      </CardPanel>\n    </Card>\n  )\n}\n",
      "type": "registry:hook",
      "target": "components/spaceui/size.tsx"
    }
  ],
  "categories": [
    "hooks",
    "dom",
    "size"
  ],
  "type": "registry:hook"
}