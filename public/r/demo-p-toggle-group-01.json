      "content": "import { IconBold, IconItalic, IconUnderline } from '@tabler/icons-react'\nimport { ToggleGroup, ToggleGroupItem } from '@/components/ui/toggle-group'\n\nexport default function Demo() {\n  return (\n    <div className=\"flex flex-col gap-4\">\n      <ToggleGroup defaultValue={['bold']} multiple variant=\"default\">\n        <ToggleGroupItem value=\"bold\">\n          <IconBold />\n        </ToggleGroupItem>\n        <ToggleGroupItem value=\"italic\">\n          <IconItalic />\n        </ToggleGroupItem>\n        <ToggleGroupItem value=\"underline\">\n          <IconUnderline />\n        </ToggleGroupItem>\n      </ToggleGroup>\n\n      <ToggleGroup defaultValue={['bold']} multiple variant=\"outline\">\n        <ToggleGroupItem value=\"bold\">\n          <IconBold />\n        </ToggleGroupItem>\n        <ToggleGroupItem value=\"italic\">\n          <IconItalic />\n        </ToggleGroupItem>\n        <ToggleGroupItem value=\"underline\">\n          <IconUnderline />\n        </ToggleGroupItem>\n      </ToggleGroup>\n    </div>\n  )\n}\n",
      "type": "registry:ui",
      "target": "components/spaceui/toggle-group.tsx"
    }
  ],
